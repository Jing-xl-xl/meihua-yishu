{
  "version": 1,
  "shengTi": {
    "qian": "公门中有喜益、功名上有喜、因官有财",
    "kun": "田土之喜、田土进财、得乡人之益",
    "zhen": "山林之益、因动中有喜",
    "xun": "山林之益、东南得财",
    "kan": "北方之喜、水边人进利",
    "li": "南方之财、文书之喜",
    "gen": "东北方之财、山田之喜",
    "dui": "西方之财、喜悦事"
  },
  "keTi": {
    "qian": "公事之忧、门户之忧",
    "kun": "田土之忧、阴人之侵",
    "zhen": "虚惊、常多恐惧",
    "xun": "草木姓人相害",
    "kan": "险陷之事、寇盗之忧",
    "li": "文书之忧、失火之惊",
    "gen": "诸事多违、百谋中阻",
    "dui": "口舌纷争、毁折之患"
  }
}
